+/// Celenn OS: the picture COSMIC Settings gives a new account
+const DEFAULT_PICTURE: &str = "/usr/share/pixmaps/faces/pop-robot.png";
+
+/// Celenn OS: the 2 px ring around an account avatar (64 px picture, 4 px
+/// padding), colored with the accent color when drawn
+static USER_RING: LazyLock<widget::svg::Handle> = LazyLock::new(|| {
+    widget::svg::Handle::from_memory(
+        &b"<svg xmlns='http://www.w3.org/2000/svg' width='72' height='72' viewBox='0 0 72 72'>\
+<circle cx='36' cy='36' r='35' fill='none' stroke='#000' stroke-width='2'/></svg>"[..],
+    )
+});
+
+/// Celenn OS: an account picture cut as a disk with a smooth edge (the
+/// image widget's own rounding has a jagged one); the picture as it is when
+/// it cannot be read
+fn round_picture(bytes: Vec<u8>) -> widget::image::Handle {
+    let Ok(picture) = image::load_from_memory(&bytes) else {
+        return widget::image::Handle::from_bytes(bytes);
+    };
+    let mut picture = picture.into_rgba8();
+    let (width, height) = picture.dimensions();
+    let center_x = width as f32 / 2.0;
+    let center_y = height as f32 / 2.0;
+    let radius = width.min(height) as f32 / 2.0;
+    for (x, y, pixel) in picture.enumerate_pixels_mut() {
+        let distance = ((x as f32 + 0.5 - center_x).powi(2)
+            + (y as f32 + 0.5 - center_y).powi(2))
+        .sqrt();
+        let coverage = (radius - distance + 0.5).clamp(0.0, 1.0);
+        pixel[3] = (f32::from(pixel[3]) * coverage).round() as u8;
+    }
+    widget::image::Handle::from_rgba(width, height, picture.into_raw())
+}
