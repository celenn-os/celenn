+/// Celenn OS: the "i" icon of a login message, colored with the text color
+/// when drawn
+static INFO_ICON: std::sync::LazyLock<widget::svg::Handle> = std::sync::LazyLock::new(|| {
+    widget::svg::Handle::from_memory(
+        &b"<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>\
+<path d='M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 1.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z'/>\
+<circle cx='8' cy='4.75' r='1'/><rect x='7.25' y='6.75' width='1.5' height='5' rx='.75'/></svg>"[..],
+    )
+});
+
+/// Celenn OS: a login message (wrong password, or a login refused by
+/// parental controls) in a light box with an icon, in the text color: the
+/// upstream pure red text could hardly be read over the dark blue panel, and
+/// sounded alarming to a child
+pub fn message_box<'a, M: 'a>(message: &'a str) -> cosmic::Element<'a, M> {
+    widget::container(
+        widget::row::with_capacity(2)
+            .spacing(10.0)
+            .push(
+                widget::container(
+                    widget::svg(INFO_ICON.clone())
+                        .width(iced::Length::Fixed(16.0))
+                        .height(iced::Length::Fixed(16.0))
+                        .class(cosmic::theme::Svg::custom(|theme| widget::svg::Style {
+                            color: Some(theme.cosmic().background(theme.transparent).on.into()),
+                        })),
+                )
+                .padding([2.0, 0.0, 0.0, 0.0]),
+            )
+            .push(widget::text::body(message).width(iced::Length::Fill)),
+    )
+    .padding([8.0, 12.0])
+    .width(iced::Length::Fill)
+    .class(cosmic::theme::Container::custom(|theme| {
+        let on = theme.cosmic().background(theme.transparent).on;
+        widget::container::Style {
+            text_color: Some(on.into()),
+            background: Some(iced::Background::Color(iced::Color {
+                a: 0.12,
+                ..on.into()
+            })),
+            border: iced::Border {
+                radius: 8.0.into(),
+                width: 1.0,
+                color: iced::Color {
+                    a: 0.16,
+                    ..on.into()
+                },
+            },
+            ..Default::default()
+        }
+    }))
+    .into()
+}
