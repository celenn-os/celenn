# Brazilian Portuguese translation of the cosmic-blue tours
# (build_files/first_steps/src/main.rs).
msgid ""
msgstr ""
"Language: pt_BR\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Back"
msgstr "Voltar"

msgid "Next"
msgstr "Próximo"

msgid "Close"
msgstr "Fechar"

msgid "Later"
msgstr "Mais tarde"

msgid "Welcome to cosmic-blue"
msgstr "Boas-vindas ao cosmic-blue"

msgid "Accessibility"
msgstr "Acessibilidade"

msgid "Screen reader: Super + Alt + S\nZoom: Super + = and Super + -"
msgstr "Leitor de tela: Super + Alt + S\nZoom: Super + = e Super + -"

msgid "Settings"
msgstr "Configurações"

msgid "First steps"
msgstr "Primeiros passos"

msgid "Open COSMIC Store"
msgstr "Abrir a COSMIC Store"

msgid "Protect your files"
msgstr "Proteja seus arquivos"

msgid "Tile your windows"
msgstr "Organize suas janelas lado a lado"

msgid "Turn tiling on or off"
msgstr "Ativar ou desativar o lado a lado"

msgid "Go to the window on the left, right, above or below"
msgstr "Ir para a janela à esquerda, à direita, acima ou abaixo"

msgid "Move the window to the left, right, up or down"
msgstr "Mover a janela para a esquerda, a direita, para cima ou para baixo"

msgid "Let a window float above the others"
msgstr "Deixar uma janela flutuando sobre as outras"

msgid "Documentation"
msgstr "Documentação"

msgid "Updates, software, commands and tips"
msgstr "Atualizações, programas, comandos e dicas"

msgid "Report a problem"
msgstr "Relatar um problema"

msgid "Found a bug or something unclear? Tell us on GitHub"
msgstr "Encontrou um bug ou algo confuso? Conte para nós no GitHub"

msgid "Open"
msgstr "Abrir"

msgid "Get started"
msgstr "Começar"

msgid "cosmic-blue is Fedora Atomic with the COSMIC desktop, made in the spirit of Bluefin: a desktop that stays out of your way and keeps itself up to date."
msgstr "cosmic-blue é o Fedora Atomic com o ambiente COSMIC, feito no espírito do Bluefin: uma área de trabalho que não atrapalha e se mantém atualizada sozinha."

msgid "Try it live"
msgstr "Experimente ao vivo"

msgid "cosmic-blue is running from the live media. Nothing is written to your disk, and your changes are lost when you shut down. You can start the installer at any time from the desktop or the dock."
msgstr "O cosmic-blue está rodando a partir da mídia live. Nada é gravado no seu disco, e suas alterações se perdem ao desligar. Você pode iniciar o instalador a qualquer momento pela área de trabalho ou pelo dock."

msgid "What you get"
msgstr "O que você ganha"

msgid "Automatic updates"
msgstr "Atualizações automáticas"

msgid "The whole system updates in the background and applies at the next restart. If something goes wrong, boot the previous version."
msgstr "O sistema inteiro se atualiza em segundo plano, e a atualização é aplicada na próxima reinicialização. Se algo der errado, inicie a versão anterior."

msgid "Apps from Flathub and COSMIC"
msgstr "Aplicativos do Flathub e do COSMIC"

msgid "Install apps with COSMIC Store, from Flathub and the COSMIC repository. They run sandboxed and update on their own."
msgstr "Instale aplicativos com a COSMIC Store, do Flathub e do repositório do COSMIC. Eles rodam isolados e se atualizam sozinhos."

msgid "Ready for the terminal"
msgstr "Pronto para o terminal"

msgid "Homebrew for command line tools, distrobox for other distributions, and ujust for common tasks."
msgstr "Homebrew para ferramentas de linha de comando, distrobox para outras distribuições e ujust para as tarefas comuns."

msgid "Ready to install?"
msgstr "Tudo pronto para instalar?"

msgid "The installer copies cosmic-blue to your disk. After that, it updates itself from the cosmic-blue image registry."
msgstr "O instalador copia o cosmic-blue para o seu disco. Depois disso, ele se atualiza sozinho pelo registro de imagens do cosmic-blue."

msgid "Install cosmic-blue"
msgstr "Instalar o cosmic-blue"

msgid "Keep trying"
msgstr "Continuar testando"

msgid "Installing your apps: {} of {}"
msgstr "Instalando seus aplicativos: {} de {}"

msgid "They show up in the app library as they arrive."
msgstr "Eles aparecem na biblioteca de aplicativos à medida que chegam."

msgid "Theme"
msgstr "Tema"

msgid "Dark"
msgstr "Escuro"

msgid "Light"
msgstr "Claro"

msgid "Wallpaper"
msgstr "Papel de parede"

msgid "Your picture"
msgstr "Sua imagem"

msgid "Send without a cable"
msgstr "Enviar sem cabo"

msgid "With LocalSend, already on this computer. The files go straight through your Wi-Fi, encrypted, not through the internet."
msgstr "Com o LocalSend, já neste computador. Os arquivos vão direto pelo seu Wi-Fi, criptografados, sem passar pela internet."

msgid "On the phone, scan this code and install LocalSend (Play Store or App Store)."
msgstr "No celular, escaneie este código e instale o LocalSend (Play Store ou App Store)."

msgid "Open LocalSend here and on the phone, on the same Wi-Fi."
msgstr "Abra o LocalSend aqui e no celular, no mesmo Wi-Fi."

msgid "On the phone, pick the photos, then this computer. They arrive in Downloads. It works the other way too."
msgstr "No celular, escolha as fotos e depois este computador. Elas chegam em Downloads. Também funciona no sentido contrário."

msgid "Open LocalSend"
msgstr "Abrir o LocalSend"

msgid "Without a cable, with LocalSend. Or plug it in and allow file transfer on the phone: it shows up in Files."
msgstr "Sem cabo, com o LocalSend. Ou conecte-o e permita a transferência de arquivos no celular: ele aparece em Arquivos."

msgid "Without a cable"
msgstr "Sem cabo"

msgid "Layout"
msgstr "Disposição"

msgid "Top bar and dock: like the Mac. One bar at the bottom: like Windows."
msgstr "Barra em cima e dock: como no Mac. Uma barra embaixo: como no Windows."

msgid "Top bar and dock"
msgstr "Barra em cima e dock"

msgid "Bar at the bottom"
msgstr "Barra embaixo"

msgid "This did not work."
msgstr "Isso não funcionou."

msgid "Installed"
msgstr "Instalado"

msgid "Development"
msgstr "Desenvolvimento"

msgid "Choose…"
msgstr "Escolher…"

msgid "Installing: {} of {}"
msgstr "Instalando: {} de {}"

msgid "Checking your computer…"
msgstr "Verificando seu computador…"

msgid "Connected to the internet"
msgstr "Conectado à internet"

msgid "No internet connection"
msgstr "Sem conexão com a internet"

msgid "Apps and updates need it."
msgstr "Os aplicativos e as atualizações precisam dela."

msgid "Network settings"
msgstr "Configurações de rede"

msgid "NVIDIA graphics card"
msgstr "Placa de vídeo NVIDIA"

msgid "Its driver is installed: this is the NVIDIA edition of cosmic-blue."
msgstr "O driver dela está instalado: esta é a edição NVIDIA do cosmic-blue."

msgid "The NVIDIA edition of cosmic-blue has its driver: about 4 GB to download, then it starts at the next restart."
msgstr "A edição NVIDIA do cosmic-blue tem o driver dela: cerca de 4 GB para baixar, e ela inicia na próxima reinicialização."

msgid "Switch"
msgstr "Trocar"

msgid "Downloading the NVIDIA edition… This can take a while."
msgstr "Baixando a edição NVIDIA… Isso pode levar um tempo."

msgid "The NVIDIA edition starts at the next restart."
msgstr "A edição NVIDIA inicia na próxima reinicialização."

msgid "At the restart, a blue screen asks to enroll a key: choose Enroll MOK, Continue, Yes, then type the password cosmicblue (the keyboard is QWERTY there)."
msgstr "Na reinicialização, uma tela azul pede para registrar uma chave: escolha Enroll MOK, Continue, Yes e digite a senha cosmicblue (lá o teclado é QWERTY)."

msgid "Firmware updates are available"
msgstr "Há atualizações de firmware disponíveis"

msgid "Firmware is up to date"
msgstr "O firmware está atualizado"

msgid "Open Firmware"
msgstr "Abrir Firmware"

msgid "Take care of the battery"
msgstr "Cuidar da bateria"

msgid "Stop charging at 80 % when the laptop stays plugged in: the battery lasts longer."
msgstr "Parar de carregar em 80 % quando o notebook fica na tomada: a bateria dura mais."

msgid "Screen scale"
msgstr "Escala da tela"

msgid "Text and windows too small or too big? Change the scale of the screen."
msgstr "Texto e janelas pequenos ou grandes demais? Mude a escala da tela."

msgid "Display settings"
msgstr "Configurações de tela"

msgid "Try"
msgstr "Experimentar"

msgid "Turn on"
msgstr "Ativar"

msgid "Turn off"
msgstr "Desativar"

msgid "Your look is set"
msgstr "Sua aparência está pronta"

msgid "Your apps are installed"
msgstr "Seus aplicativos estão instalados"

msgid "Plug in a USB drive and turn on automatic backups: Déjà Dup keeps a copy of your home folder."
msgstr "Conecte um pendrive e ative os backups automáticos: o Déjà Dup guarda uma cópia da sua pasta pessoal."

msgid "Set up backups"
msgstr "Configurar backups"

msgid "This tour and the Keyboard shortcuts app stay in the app library."
msgstr "Este tour e o aplicativo Atalhos de teclado continuam na biblioteca de aplicativos."

msgid "“{}” does not install here"
msgstr "“{}” não se instala aqui"

msgid "This is a Windows program. On cosmic-blue, apps come from COSMIC Store: most well-known apps are there, or a good alternative."
msgstr "Este é um programa do Windows. No cosmic-blue, os aplicativos vêm da COSMIC Store: a maioria dos aplicativos conhecidos está lá, ou uma boa alternativa."

msgid "This is a package for Debian and Ubuntu. On cosmic-blue, apps come from COSMIC Store: most well-known apps are there, or a good alternative."
msgstr "Este é um pacote para Debian e Ubuntu. No cosmic-blue, os aplicativos vêm da COSMIC Store: a maioria dos aplicativos conhecidos está lá, ou uma boa alternativa."

msgid "This is a package for Fedora. cosmic-blue's system is a read-only image: apps come from COSMIC Store instead. Most well-known apps are there, or a good alternative."
msgstr "Este é um pacote para o Fedora. O sistema do cosmic-blue é uma imagem somente leitura: os aplicativos vêm da COSMIC Store. A maioria dos aplicativos conhecidos está lá, ou uma boa alternativa."

msgid "Search for “{}” in COSMIC Store"
msgstr "Buscar “{}” na COSMIC Store"

msgid "A Windows program with no equivalent? Bottles, in COSMIC Store, runs some of them."
msgstr "Um programa do Windows sem equivalente? O Bottles, na COSMIC Store, executa alguns deles."

msgid "Open with Bottles"
msgstr "Abrir com o Bottles"

msgid "See the equivalents of Windows programs"
msgstr "Ver os equivalentes dos programas do Windows"

msgid "For advanced users: distrobox installs it in a container of another distribution."
msgstr "Para usuários avançados: o distrobox o instala em um contêiner de outra distribuição."

msgid "Keyboard shortcuts"
msgstr "Atalhos de teclado"

msgid "Super is the key with the Windows logo on most keyboards."
msgstr "Super é a tecla com o logotipo do Windows na maioria dos teclados."

msgid "Change them in Settings"
msgstr "Alterá-los nas Configurações"

msgid "Your bearings from Windows"
msgstr "Suas referências do Windows"

msgid "Your bearings from the Mac"
msgstr "Suas referências do Mac"

msgid "Office"
msgstr "Escritório"

msgid "LibreOffice: documents, spreadsheets and presentations, Word and Excel files included"
msgstr "LibreOffice: documentos, planilhas e apresentações, incluindo arquivos do Word e do Excel"

msgid "Games"
msgstr "Jogos"

msgid "Steam, and Heroic Games Launcher for Epic Games and GOG"
msgstr "Steam, e Heroic Games Launcher para Epic Games e GOG"

msgid "Open the launcher"
msgstr "Abrir o lançador"

msgid "Press Super, type the name of an app, then Enter."
msgstr "Pressione Super, digite o nome de um aplicativo e depois Enter."

msgid "See all your apps"
msgstr "Ver todos os seus aplicativos"

msgid "Super + A"
msgstr "Super + A"

msgid "See your workspaces"
msgstr "Ver seus espaços de trabalho"

msgid "Super + W: one desktop per activity. Super + Ctrl + arrows goes from one to the next."
msgstr "Super + W: uma área de trabalho por atividade. Super + Ctrl + setas passa de uma para outra."

msgid "Windows side by side, without overlap. Super + Y turns it on or off."
msgstr "Janelas lado a lado, sem sobreposição. Super + Y ativa ou desativa."

msgid "Take a screenshot"
msgstr "Fazer uma captura de tela"

msgid "Super + Shift + S, or the Print Screen key"
msgstr "Super + Shift + S, ou a tecla Print Screen"

msgid "Desktop"
msgstr "Área de trabalho"

msgid "See your windows and workspaces"
msgstr "Ver suas janelas e espaços de trabalho"

msgid "Lock the screen"
msgstr "Bloquear a tela"

msgid "Windows"
msgstr "Janelas"

msgid "Go from one window to the next"
msgstr "Passar de uma janela para outra"

msgid "Close the window"
msgstr "Fechar a janela"

msgid "Maximize the window"
msgstr "Maximizar a janela"

msgid "Workspaces"
msgstr "Espaços de trabalho"

msgid "Go to the next or previous workspace"
msgstr "Ir para o espaço de trabalho seguinte ou anterior"

msgid "Go to a workspace"
msgstr "Ir para um espaço de trabalho"

msgid "Move the window to a workspace"
msgstr "Mover a janela para um espaço de trabalho"

msgid "Apps"
msgstr "Aplicativos"

msgid "Terminal"
msgstr "Terminal"

msgid "Files"
msgstr "Arquivos"

msgid "System monitor"
msgstr "Monitor do sistema"

msgid "Turn the screen reader on or off"
msgstr "Ativar ou desativar o leitor de tela"

msgid "Zoom in and out"
msgstr "Aumentar e diminuir o zoom"

msgid "Your system is installed and ready. Where do you come from? The tour adapts to you."
msgstr "Seu sistema está instalado e pronto. De onde você vem? O tour se adapta a você."

msgid "Make it yours"
msgstr "Do seu jeito"

msgid "What do you use your computer for?"
msgstr "Para que você usa o computador?"

msgid "Pick what concerns you: nothing installs without a click, and everything can be removed later."
msgstr "Marque o que interessa a você: nada é instalado sem um clique, e tudo pode ser removido depois."

msgid "Thousands of other apps are in COSMIC Store."
msgstr "Milhares de outros aplicativos estão na COSMIC Store."

msgid "Your computer"
msgstr "Seu computador"

msgid "Checked for you: only what concerns this computer shows up."
msgstr "Verificado para você: só aparece o que diz respeito a este computador."

msgid "Try it, it is safe"
msgstr "Experimente, é seguro"

msgid "Each button does the real thing."
msgstr "Cada botão faz a ação de verdade."

msgid "Bring your things"
msgstr "Traga suas coisas"

msgid "Your files, bookmarks and email from before."
msgstr "Seus arquivos, favoritos e e-mails de antes."

msgid "Files from an old disk"
msgstr "Arquivos de um disco antigo"

msgid "Plug it in: it shows up in Files, on the left. A Windows partition of this computer too."
msgstr "Conecte-o: ele aparece em Arquivos, à esquerda. Uma partição do Windows deste computador também."

msgid "Open Files"
msgstr "Abrir Arquivos"

msgid "Photos from a phone"
msgstr "Fotos de um celular"

msgid "Bookmarks and passwords"
msgstr "Favoritos e senhas"

msgid "Export them from your old browser (an HTML file for bookmarks, a CSV file for passwords), then import them in Firefox."
msgstr "Exporte-os do seu navegador antigo (um arquivo HTML para os favoritos, um arquivo CSV para as senhas) e depois importe-os no Firefox."

msgid "Open Firefox"
msgstr "Abrir o Firefox"

msgid "Email"
msgstr "E-mail"

msgid "Thunderbird sets up your account with just your address and password."
msgstr "O Thunderbird configura sua conta só com seu endereço e sua senha."

msgid "Open Thunderbird"
msgstr "Abrir o Thunderbird"

msgid "Good to know"
msgstr "Bom saber"

msgid "Three things that work differently here."
msgstr "Três coisas que funcionam de outro jeito aqui."

msgid "Updates apply at the next restart"
msgstr "As atualizações são aplicadas na próxima reinicialização"

msgid "The system updates itself in the background, without interrupting you. Something wrong after an update? Go back to the previous version in one click."
msgstr "O sistema se atualiza sozinho em segundo plano, sem interromper você. Algo deu errado depois de uma atualização? Volte para a versão anterior com um clique."

msgid "Updates"
msgstr "Atualizações"

msgid "An app cannot see a folder or a USB drive?"
msgstr "Um aplicativo não vê uma pasta ou um pendrive?"

msgid "Apps run apart from the system and only see what they need. Flatseal gives them access to more."
msgstr "Os aplicativos rodam separados do sistema e só veem o que precisam. O Flatseal dá acesso a mais coisas."

msgid "Open Flatseal"
msgstr "Abrir o Flatseal"

msgid "A downloaded .exe, .deb or .rpm file?"
msgstr "Um arquivo .exe, .deb ou .rpm baixado?"

msgid "They do not install on cosmic-blue: look for the app in COSMIC Store, where it updates by itself."
msgstr "Eles não se instalam no cosmic-blue: procure o aplicativo na COSMIC Store, onde ele se atualiza sozinho."

msgid "You are ready"
msgstr "Você está pronto"

msgid "One more thing worth doing: backups."
msgstr "Mais uma coisa que vale a pena: os backups."

msgid "What changes, and what stays the same."
msgstr "O que muda e o que continua igual."

msgid "Windows key → the Super key"
msgstr "Tecla Windows → a tecla Super"

msgid "It opens the launcher, like the Start menu: type the name of an app"
msgstr "Ela abre o lançador, como o menu Iniciar: digite o nome de um aplicativo"

msgid "Microsoft Store → COSMIC Store"
msgstr "Microsoft Store → COSMIC Store"

msgid "Apps install and update from there"
msgstr "Os aplicativos são instalados e atualizados por lá"

msgid "File Explorer → Files"
msgstr "Explorador de Arquivos → Arquivos"

msgid "Super + E opens it, as on Windows"
msgstr "Super + E o abre, como no Windows"

msgid "Settings and Control Panel → Settings"
msgstr "Configurações e Painel de Controle → Configurações"

msgid "Everything in one place"
msgstr "Tudo em um só lugar"

msgid "Office → LibreOffice"
msgstr "Office → LibreOffice"

msgid "It opens and saves Word, Excel and PowerPoint files"
msgstr "Ele abre e salva arquivos do Word, Excel e PowerPoint"

msgid "Same as on Windows"
msgstr "Igual ao Windows"

msgid "Alt + Tab, Ctrl + C and Ctrl + V, Super + Shift + S for a screenshot, Ctrl + Shift + Esc for the task manager"
msgstr "Alt + Tab, Ctrl + C e Ctrl + V, Super + Shift + S para uma captura de tela, Ctrl + Shift + Esc para o gerenciador de tarefas"

msgid "Command key → Ctrl, most of the time"
msgstr "Tecla Command → Ctrl, na maioria das vezes"

msgid "Copy, paste, save: Ctrl + C, Ctrl + V, Ctrl + S"
msgstr "Copiar, colar, salvar: Ctrl + C, Ctrl + V, Ctrl + S"

msgid "Spotlight → the Super key"
msgstr "Spotlight → a tecla Super"

msgid "Super opens the launcher: type the name of an app"
msgstr "Super abre o lançador: digite o nome de um aplicativo"

msgid "App Store → COSMIC Store"
msgstr "App Store → COSMIC Store"

msgid "Finder → Files"
msgstr "Finder → Arquivos"

msgid "Super + E opens it"
msgstr "Super + E o abre"

msgid "Mission Control → Super + W"
msgstr "Mission Control → Super + W"

msgid "Your windows and workspaces at a glance"
msgstr "Suas janelas e espaços de trabalho num relance"

msgid "System Settings → Settings"
msgstr "Ajustes do Sistema → Configurações"

msgid "Everything in one place, Settings → Desktop for the look"
msgstr "Tudo em um só lugar, Configurações → Área de trabalho para a aparência"

msgid "Docker, VS Code, Zed, Neovim…: choose your tools"
msgstr "Docker, VS Code, Zed, Neovim…: escolha suas ferramentas"

msgid "Chosen: {}"
msgstr "Escolhidas: {}"

msgid "Install and continue"
msgstr "Instalar e continuar"

msgid "Containers"
msgstr "Contêineres"

msgid "Code editors"
msgstr "Editores de código"

msgid "In the terminal"
msgstr "No terminal"

msgid "Ticked and grey: already installed. Lima and virtual machines: ujust install-dev-tools and ujust install-vms, in a terminal."
msgstr "Marcado e cinza: já instalado. Lima e máquinas virtuais: ujust install-dev-tools e ujust install-vms, em um terminal."

msgid "Homebrew is still being set up: the code editors and terminal tools can be chosen in a few minutes."
msgstr "O Homebrew ainda está sendo configurado: os editores de código e as ferramentas de terminal poderão ser escolhidos em alguns minutos."

msgid "Back to the list"
msgstr "Voltar à lista"

msgid "What is different from your distribution"
msgstr "O que muda em relação à sua distribuição"

msgid "Graphics and drawing"
msgstr "Gráficos e desenho"

msgid "GIMP for photos, Inkscape for illustrations and logos, Krita for digital painting"
msgstr "GIMP para fotos, Inkscape para ilustrações e logotipos, Krita para pintura digital"

msgid "Videos and streaming"
msgstr "Vídeo e streaming"

msgid "OBS Studio to record and stream, Kdenlive to edit videos, Audacity for sound"
msgstr "OBS Studio para gravar e transmitir, Kdenlive para editar vídeos, Audacity para o som"

msgid "What is different here"
msgstr "O que muda aqui"

msgid "Another Linux, with its own habits, and an app for each of them."
msgstr "Outro Linux, com seus hábitos, e um aplicativo para cada um."

msgid "The system is an image"
msgstr "O sistema é uma imagem"

msgid "Signed and read-only, it updates as a whole: no dnf on the system, and the previous version is one click away."
msgstr "Assinado e somente leitura, ele é atualizado por inteiro: nada de dnf no sistema, e a versão anterior está a um clique."

msgid "Apps → COSMIC Store"
msgstr "Aplicativos → COSMIC Store"

msgid "Flatpak apps from Flathub, kept apart from the system"
msgstr "Aplicativos Flatpak do Flathub, separados do sistema"

msgid "Packages from other distributions → DistroShelf"
msgstr "Pacotes de outras distribuições → DistroShelf"

msgid "Arch, Debian, Ubuntu… in a container that shares your home folder, set up in a few clicks"
msgstr "Arch, Debian, Ubuntu… em um contêiner que compartilha sua pasta pessoal, pronto em poucos cliques"

msgid "Open DistroShelf"
msgstr "Abrir o DistroShelf"

msgid "If you like the terminal"
msgstr "Se você gosta do terminal"

msgid "ujust lists the system's recipes, brew installs command line tools: the documentation has them all."
msgstr "ujust lista as receitas do sistema, brew instala ferramentas de linha de comando: a documentação traz todas."

msgid "“{}” did not work"
msgstr "“{}” não funcionou"

msgid "No internet connection. Connect to a network, then try again. Nothing was changed."
msgstr "Sem conexão com a internet. Conecte-se a uma rede e tente de novo. Nada foi alterado."

msgid "The disk is full ({} free). Free up space with Clean up, in cosmic-blue Tools, Maintenance, then try again."
msgstr "O disco está cheio ({} livres). Libere espaço com Limpar, em Ferramentas do cosmic-blue, Manutenção, e tente de novo."

msgid "The server does not answer. Try again in a few minutes."
msgstr "O servidor não responde. Tente de novo em alguns minutos."

msgid "Something unexpected went wrong. Nothing was changed."
msgstr "Algo inesperado deu errado. Nada foi alterado."

msgid "Try again"
msgstr "Tentar de novo"

msgid "Report the problem"
msgstr "Relatar o problema"

msgid "Technical details"
msgstr "Detalhes técnicos"

msgid "The report opens in your browser, filled in: the cosmic-blue version, the hardware and this error. No files or personal data. You read it before sending it; write in your own language. Sending needs a GitHub account."
msgstr "O relatório abre no navegador, já preenchido: a versão do cosmic-blue, o hardware e este erro. Nenhum arquivo ou dado pessoal. Você revisa antes de enviar; escreva no seu idioma. Para enviar é preciso uma conta no GitHub."

msgid "Open the report"
msgstr "Abrir o relatório"

msgid "Cancel"
msgstr "Cancelar"
