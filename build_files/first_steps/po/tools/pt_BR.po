# Brazilian Portuguese translation of cosmic-blue Tools
# (build_files/first_steps/src/tools.rs and its pages).
msgid ""
msgstr ""
"Language: pt_BR\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Updates"
msgstr "Atualizações"

msgid "cosmic-blue updates itself in the background. A new version starts at the next restart, without interrupting you."
msgstr "O cosmic-blue se atualiza sozinho em segundo plano. Uma nova versão começa na próxima reinicialização, sem interromper você."

msgid "Current version: {}"
msgstr "Versão atual: {}"

msgid "Weekly updates, tested before they come out"
msgstr "Atualizações semanais, testadas antes de saírem"

msgid "Daily updates, sooner but less tested"
msgstr "Atualizações diárias, mais cedo, porém menos testadas"

msgid "dev channel: every change, for testers"
msgstr "Canal dev: cada mudança, para testadores"

msgid "This system stays on this version: it does not update by itself."
msgstr "Este sistema fica nesta versão: ele não se atualiza sozinho."

msgid "Check now"
msgstr "Verificar agora"

msgid "Checking…"
msgstr "Verificando…"

msgid "You are up to date."
msgstr "O sistema está atualizado."

msgid "The check did not work. Are you online?"
msgstr "A verificação não funcionou. Você está conectado à internet?"

msgid "Ready for the next restart: {}"
msgstr "Pronta para a próxima reinicialização: {}"

msgid "Downloaded and checked. It takes effect at the next restart."
msgstr "Baixada e verificada. Ela entra em vigor na próxima reinicialização."

msgid "Restart"
msgstr "Reiniciar"

msgid "Previous version: {}"
msgstr "Versão anterior: {}"

msgid "Something wrong since the last update? Go back to this version. Your files and settings stay as they are."
msgstr "Algo deu errado desde a última atualização? Volte para esta versão. Seus arquivos e configurações continuam como estão."

msgid "Go back to it"
msgstr "Voltar para esta"

msgid "Back to {} at the next restart"
msgstr "Volta para {} na próxima reinicialização"

msgid "Your files and settings stay as they are. The version you leave will not be installed again: updates start again with the next one."
msgstr "Seus arquivos e configurações continuam como estão. A versão que você deixa não será instalada de novo: as atualizações voltam com a próxima."

msgid "Version {} is set aside"
msgstr "A versão {} foi deixada de lado"

msgid "You went back from it, so it will not be installed again. Updates start again with the next version."
msgstr "Você voltou dela, então ela não será instalada de novo. As atualizações voltam com a próxima versão."

msgid "Get new features early"
msgstr "Receber as novidades antes"

msgid ""
"Off (recommended): one tested update a week.\n"
"On: an update every day, sooner but less tested."
msgstr ""
"Desativado (recomendado): uma atualização testada por semana.\n"
"Ativado: uma atualização por dia, mais cedo, porém menos testada."

msgid "You follow the dev channel, chosen in a terminal. Turn this off to go back to one tested update a week."
msgstr "Você segue o canal dev, escolhido em um terminal. Desative isto para voltar a uma atualização testada por semana."

msgid "Downloading the new version… This can take a few minutes."
msgstr "Baixando a nova versão… Isso pode levar alguns minutos."

msgid "Something went wrong, nothing was changed."
msgstr "Algo deu errado, nada foi alterado."

msgid "The system version could not be read: is this computer installed with cosmic-blue?"
msgstr "Não foi possível ler a versão do sistema: este computador está instalado com o cosmic-blue?"

msgid "Apps from COSMIC Store update by themselves too."
msgstr "Os aplicativos da COSMIC Store também se atualizam sozinhos."

msgid "What's new"
msgstr "Novidades"

msgid "An older version"
msgstr "Uma versão mais antiga"

msgid "Choose the stable version of a past week. The system then stays on it, without updates, until you resume them."
msgstr "Escolher a versão estável de uma semana passada. O sistema fica nela, sem atualizações, até você retomá-las."

msgid "Choose…"
msgstr "Escolher…"

msgid "Hide"
msgstr "Ocultar"

msgid "Stable version of {}"
msgstr "Versão estável de {}"

msgid "Use this one"
msgstr "Usar esta"

msgid "No older version found. Are you online?"
msgstr "Nenhuma versão mais antiga encontrada. Você está conectado à internet?"

msgid "{y}-{m}-{d}"
msgstr "{d}/{m}/{y}"

msgid "Updates are paused"
msgstr "As atualizações estão pausadas"

msgid "This system stays on this version. Resume them to get one tested update a week again."
msgstr "Este sistema fica nesta versão. Retome-as para voltar a receber uma atualização testada por semana."

msgid "Resume updates"
msgstr "Retomar as atualizações"

msgid "cosmic-blue Tools"
msgstr "Ferramentas do cosmic-blue"

msgid "Maintenance"
msgstr "Manutenção"

msgid "Keep the computer tidy and in shape, without typing commands."
msgstr "Manter o computador organizado e em forma, sem digitar comandos."

msgid "Disk space"
msgstr "Espaço em disco"

msgid "{used} used of {total}"
msgstr "{used} usados de {total}"

msgid "{} free"
msgstr "{} livres"

msgid "See what takes space"
msgstr "Ver o que ocupa espaço"

msgid "Free up space"
msgstr "Liberar espaço"

msgid "Removes what nothing uses any more: leftover parts of removed apps, unused container images, old downloads of tools. Your files stay as they are."
msgstr "Remove o que nada mais usa: restos de aplicativos removidos, imagens de contêiner sem uso, downloads antigos de ferramentas. Seus arquivos ficam como estão."

msgid "Clean up"
msgstr "Limpar"

msgid "Cleaning up…"
msgstr "Limpando…"

msgid "{} freed"
msgstr "{} liberados"

msgid "Everything was already tidy."
msgstr "Tudo já estava em ordem."

msgid "Apps that come with cosmic-blue"
msgstr "Aplicativos que vêm com o cosmic-blue"

msgid "All of them are installed."
msgstr "Todos estão instalados."

msgid "One of them was removed. Put it back?"
msgstr "Um deles foi removido. Reinstalar?"

msgid "{} of them were removed. Put them back?"
msgstr "{} deles foram removidos. Reinstalar?"

msgid "Reinstall"
msgstr "Reinstalar"

msgid "Installing…"
msgstr "Instalando…"

msgid "The apps are back."
msgstr "Os aplicativos estão de volta."

msgid "The apps could not be installed. Are you online?"
msgstr "Não foi possível instalar os aplicativos. Você está conectado?"

msgid "Firmware updates"
msgstr "Atualizações de firmware"

msgid "New versions of the BIOS, SSD, dock… from their makers."
msgstr "Novas versões do BIOS, SSD, dock… dos fabricantes."

msgid "Open"
msgstr "Abrir"

msgid "Help"
msgstr "Ajuda"

msgid "Find answers, ask a question, or tell us what goes wrong."
msgstr "Encontrar respostas, fazer uma pergunta ou nos contar o que dá errado."

msgid "Documentation"
msgstr "Documentação"

msgid "Updates, software, commands and tips"
msgstr "Atualizações, programas, comandos e dicas"

msgid "Ask a question"
msgstr "Fazer uma pergunta"

msgid "Other cosmic-blue users and its makers answer, on GitHub."
msgstr "Outros usuários do cosmic-blue e seus autores respondem, no GitHub."

msgid "Report a problem"
msgstr "Relatar um problema"

msgid "Opens the bug report form with the details of this computer filled in. They hold no personal data. A GitHub account is needed."
msgstr "Abre o formulário de relato de erro com os detalhes deste computador já preenchidos. Eles não contêm dados pessoais. É preciso uma conta do GitHub."

msgid "Show the details"
msgstr "Ver os detalhes"

msgid "Hide the details"
msgstr "Ocultar os detalhes"

msgid "Report"
msgstr "Relatar"

msgid "Copy"
msgstr "Copiar"

msgid "Copied."
msgstr "Copiado."

msgid "B"
msgstr "B"

msgid "kB"
msgstr "kB"

msgid "MB"
msgstr "MB"

msgid "GB"
msgstr "GB"

msgid "TB"
msgstr "TB"
