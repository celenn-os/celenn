# Spanish translation of the cosmic-blue tours
# (build_files/first_steps/src/main.rs).
msgid ""
msgstr ""
"Language: es\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Back"
msgstr "Atrás"

msgid "Next"
msgstr "Siguiente"

msgid "Close"
msgstr "Cerrar"

msgid "Later"
msgstr "Más tarde"

msgid "Copy"
msgstr "Copiar"

msgid "Copied"
msgstr "Copiado"

msgid "Welcome to cosmic-blue"
msgstr "Te damos la bienvenida a cosmic-blue"

msgid "Accessibility"
msgstr "Accesibilidad"

msgid "Screen reader: Super + Alt + S\nZoom: Super + = and Super + -"
msgstr "Lector de pantalla: Super + Alt + S\nZoom: Super + = y Super + -"

msgid "Settings"
msgstr "Configuración"

msgid "First steps"
msgstr "Primeros pasos"

msgid "Open COSMIC Store"
msgstr "Abrir COSMIC Store"

msgid "Command line tools, installed in your home folder with Homebrew"
msgstr "Herramientas de línea de comandos, instaladas en tu carpeta personal con Homebrew"

msgid "Packages from other distributions, in a container that shares your home folder"
msgstr "Paquetes de otras distribuciones, en un contenedor que comparte tu carpeta personal"

msgid "Update everything now, without waiting"
msgstr "Actualizar todo ahora, sin esperar"

msgid "An update broke something? Go back to the previous version, then restart"
msgstr "¿Una actualización rompió algo? Vuelve a la versión anterior y reinicia"

msgid "Protect your files"
msgstr "Protege tus archivos"

msgid "Tile your windows"
msgstr "Organiza tus ventanas en mosaico"

msgid "Turn tiling on or off"
msgstr "Activar o desactivar el mosaico"

msgid "Go to the window on the left, right, above or below"
msgstr "Ir a la ventana de la izquierda, derecha, arriba o abajo"

msgid "Move the window to the left, right, up or down"
msgstr "Mover la ventana a la izquierda, derecha, arriba o abajo"

msgid "Let a window float above the others"
msgstr "Dejar una ventana flotando sobre las demás"

msgid "Documentation"
msgstr "Documentación"

msgid "Updates, software, commands and tips"
msgstr "Actualizaciones, software, comandos y consejos"

msgid "Report a problem"
msgstr "Informar de un problema"

msgid "Found a bug or something unclear? Tell us on GitHub"
msgstr "¿Encontraste un error o algo poco claro? Cuéntanoslo en GitHub"

msgid "Open"
msgstr "Abrir"

msgid "Get started"
msgstr "Empezar"

msgid "cosmic-blue is Fedora Atomic with the COSMIC desktop, made in the spirit of Bluefin: a desktop that stays out of your way and keeps itself up to date."
msgstr "cosmic-blue es Fedora Atomic con el escritorio COSMIC, hecho con el espíritu de Bluefin: un escritorio que no se interpone y se mantiene al día solo."

msgid "Try it live"
msgstr "Pruébalo en vivo"

msgid "cosmic-blue is running from the live media. Nothing is written to your disk, and your changes are lost when you shut down. You can start the installer at any time from the desktop or the dock."
msgstr "cosmic-blue se está ejecutando desde el medio live. No se escribe nada en tu disco y tus cambios se pierden al apagar. Puedes iniciar el instalador en cualquier momento desde el escritorio o el dock."

msgid "What you get"
msgstr "Lo que obtienes"

msgid "Automatic updates"
msgstr "Actualizaciones automáticas"

msgid "The whole system updates in the background and applies at the next restart. If something goes wrong, boot the previous version."
msgstr "Todo el sistema se actualiza en segundo plano y se aplica en el siguiente reinicio. Si algo sale mal, arranca la versión anterior."

msgid "Apps from Flathub and COSMIC"
msgstr "Aplicaciones de Flathub y COSMIC"

msgid "Install apps with COSMIC Store, from Flathub and the COSMIC repository. They run sandboxed and update on their own."
msgstr "Instala aplicaciones con COSMIC Store, desde Flathub y el repositorio de COSMIC. Funcionan aisladas y se actualizan solas."

msgid "Ready for the terminal"
msgstr "Listo para la terminal"

msgid "Homebrew for command line tools, distrobox for other distributions, and ujust for common tasks."
msgstr "Homebrew para las herramientas de línea de comandos, distrobox para otras distribuciones y ujust para las tareas comunes."

msgid "Ready to install?"
msgstr "¿Todo listo para instalar?"

msgid "The installer copies cosmic-blue to your disk. After that, it updates itself from the cosmic-blue image registry."
msgstr "El instalador copia cosmic-blue en tu disco. Después, se actualiza solo desde el registro de imágenes de cosmic-blue."

msgid "Install cosmic-blue"
msgstr "Instalar cosmic-blue"

msgid "Keep trying"
msgstr "Seguir probando"

msgid "Installing your apps: {} of {}"
msgstr "Instalando tus aplicaciones: {} de {}"

msgid "They show up in the app library as they arrive."
msgstr "Aparecen en la biblioteca de aplicaciones a medida que llegan."

msgid "Theme"
msgstr "Tema"

msgid "Dark"
msgstr "Oscuro"

msgid "Light"
msgstr "Claro"

msgid "Wallpaper"
msgstr "Fondo de pantalla"

msgid "Your picture"
msgstr "Tu imagen"

msgid "Dock always visible"
msgstr "Dock siempre visible"

msgid "This did not work."
msgstr "No ha funcionado."

msgid "Installed"
msgstr "Instalado"

msgid "Development"
msgstr "Desarrollo"

msgid "Docker, VS Code, Podman Desktop… picked from a menu, in a terminal"
msgstr "Docker, VS Code, Podman Desktop… elegidos en un menú, en una terminal"

msgid "Choose…"
msgstr "Elegir…"

msgid "Install the selection"
msgstr "Instalar la selección"

msgid "Installing: {} of {}"
msgstr "Instalando: {} de {}"

msgid "Some apps did not install. Are you online? They are also in COSMIC Store."
msgstr "Algunas aplicaciones no se han instalado. ¿Tienes conexión? También están en COSMIC Store."

msgid "Press Enter to close this window."
msgstr "Pulsa Intro para cerrar esta ventana."

msgid "Checking your computer…"
msgstr "Comprobando tu ordenador…"

msgid "Connected to the internet"
msgstr "Conectado a internet"

msgid "No internet connection"
msgstr "Sin conexión a internet"

msgid "Apps and updates need it."
msgstr "Las aplicaciones y las actualizaciones la necesitan."

msgid "Network settings"
msgstr "Configuración de red"

msgid "NVIDIA graphics card"
msgstr "Tarjeta gráfica NVIDIA"

msgid "Its driver is installed: this is the NVIDIA edition of cosmic-blue."
msgstr "Su controlador está instalado: esta es la edición NVIDIA de cosmic-blue."

msgid "The NVIDIA edition of cosmic-blue has its driver: about 4 GB to download, then it starts at the next restart."
msgstr "La edición NVIDIA de cosmic-blue incluye su controlador: unos 4 GB de descarga, y se inicia en el siguiente reinicio."

msgid "Switch"
msgstr "Cambiar"

msgid "Downloading the NVIDIA edition… This can take a while."
msgstr "Descargando la edición NVIDIA… Puede tardar un rato."

msgid "The NVIDIA edition starts at the next restart."
msgstr "La edición NVIDIA se inicia en el siguiente reinicio."

msgid "At the restart, a blue screen asks to enroll a key: choose Enroll MOK, Continue, Yes, then type the password cosmicblue (the keyboard is QWERTY there)."
msgstr "Al reiniciar, una pantalla azul pide registrar una clave: elige Enroll MOK, Continue, Yes y escribe la contraseña cosmicblue (allí el teclado es QWERTY)."

msgid "Firmware updates are available"
msgstr "Hay actualizaciones de firmware disponibles"

msgid "Firmware is up to date"
msgstr "El firmware está al día"

msgid "Open Firmware"
msgstr "Abrir Firmware"

msgid "Take care of the battery"
msgstr "Cuidar la batería"

msgid "Stop charging at 80 % when the laptop stays plugged in: the battery lasts longer."
msgstr "Dejar de cargar al 80 % cuando el portátil está siempre enchufado: la batería dura más."

msgid "Screen scale"
msgstr "Escala de la pantalla"

msgid "Text and windows too small or too big? Change the scale of the screen."
msgstr "¿Texto y ventanas demasiado pequeños o grandes? Cambia la escala de la pantalla."

msgid "Display settings"
msgstr "Configuración de pantalla"

msgid "Try"
msgstr "Probar"

msgid "Turn on"
msgstr "Activar"

msgid "Turn off"
msgstr "Desactivar"

msgid "Your look is set"
msgstr "Tu apariencia está lista"

msgid "Your apps are installed"
msgstr "Tus aplicaciones están instaladas"

msgid "Plug in a USB drive and turn on automatic backups: Déjà Dup keeps a copy of your home folder."
msgstr "Conecta una memoria USB y activa las copias de seguridad automáticas: Déjà Dup guarda una copia de tu carpeta personal."

msgid "Set up backups"
msgstr "Configurar copias de seguridad"

msgid "This tour and the Keyboard shortcuts app stay in the app library."
msgstr "Este recorrido y la aplicación Atajos de teclado siguen en la biblioteca de aplicaciones."

msgid "“{}” does not install here"
msgstr "«{}» no se instala aquí"

msgid "This is a Windows program. On cosmic-blue, apps come from COSMIC Store: most well-known apps are there, or a good alternative."
msgstr "Es un programa de Windows. En cosmic-blue, las aplicaciones vienen de COSMIC Store: allí están las más conocidas, o una buena alternativa."

msgid "This is a package for Debian and Ubuntu. On cosmic-blue, apps come from COSMIC Store: most well-known apps are there, or a good alternative."
msgstr "Es un paquete para Debian y Ubuntu. En cosmic-blue, las aplicaciones vienen de COSMIC Store: allí están las más conocidas, o una buena alternativa."

msgid "This is a package for Fedora. cosmic-blue's system is a read-only image: apps come from COSMIC Store instead. Most well-known apps are there, or a good alternative."
msgstr "Es un paquete para Fedora. El sistema de cosmic-blue es una imagen de solo lectura: las aplicaciones vienen de COSMIC Store. Allí están las más conocidas, o una buena alternativa."

msgid "Search for “{}” in COSMIC Store"
msgstr "Buscar «{}» en COSMIC Store"

msgid "A Windows program with no equivalent? Bottles, in COSMIC Store, runs some of them."
msgstr "¿Un programa de Windows sin equivalente? Bottles, en COSMIC Store, ejecuta algunos."

msgid "Open with Bottles"
msgstr "Abrir con Bottles"

msgid "For advanced users: distrobox installs it in a container of another distribution."
msgstr "Para usuarios avanzados: distrobox lo instala en un contenedor de otra distribución."

msgid "Keyboard shortcuts"
msgstr "Atajos de teclado"

msgid "Super is the key with the Windows logo on most keyboards."
msgstr "Super es la tecla con el logotipo de Windows en la mayoría de los teclados."

msgid "Change them in Settings"
msgstr "Cambiarlos en Configuración"

msgid "Your bearings from Windows"
msgstr "Tus referencias de Windows"

msgid "Your bearings from the Mac"
msgstr "Tus referencias del Mac"

msgid "The short version, with the commands"
msgstr "La versión corta, con los comandos"

msgid "Office"
msgstr "Ofimática"

msgid "LibreOffice: documents, spreadsheets and presentations, Word and Excel files included"
msgstr "LibreOffice: documentos, hojas de cálculo y presentaciones, también archivos de Word y Excel"

msgid "Games"
msgstr "Juegos"

msgid "Steam, and Heroic Games Launcher for Epic Games and GOG"
msgstr "Steam, y Heroic Games Launcher para Epic Games y GOG"

msgid "Creative work"
msgstr "Creación"

msgid "GIMP for photos, Inkscape for drawings, Krita for painting, Kdenlive for videos"
msgstr "GIMP para fotos, Inkscape para dibujos, Krita para pintar, Kdenlive para vídeos"

msgid "Open the launcher"
msgstr "Abrir el lanzador"

msgid "Press Super, type the name of an app, then Enter. Super is the key with the Windows logo on most keyboards."
msgstr "Pulsa Super, escribe el nombre de una aplicación y luego Intro. Super es la tecla con el logotipo de Windows en la mayoría de los teclados."

msgid "See all your apps"
msgstr "Ver todas tus aplicaciones"

msgid "Super + A"
msgstr "Super + A"

msgid "See your workspaces"
msgstr "Ver tus espacios de trabajo"

msgid "Super + W: one desktop per activity. Super + Ctrl + arrows goes from one to the next."
msgstr "Super + W: un escritorio por actividad. Super + Ctrl + flechas pasa de uno a otro."

msgid "Windows side by side, without overlap. Super + Y turns it on or off."
msgstr "Ventanas lado a lado, sin superponerse. Super + Y lo activa o desactiva."

msgid "Take a screenshot"
msgstr "Hacer una captura de pantalla"

msgid "Super + Shift + S, or the Print Screen key"
msgstr "Super + Mayús + S, o la tecla Impr Pant"

msgid "Desktop"
msgstr "Escritorio"

msgid "See your windows and workspaces"
msgstr "Ver tus ventanas y espacios de trabajo"

msgid "Lock the screen"
msgstr "Bloquear la pantalla"

msgid "Windows"
msgstr "Ventanas"

msgid "Go from one window to the next"
msgstr "Pasar de una ventana a otra"

msgid "Close the window"
msgstr "Cerrar la ventana"

msgid "Maximize the window"
msgstr "Maximizar la ventana"

msgid "Workspaces"
msgstr "Espacios de trabajo"

msgid "Go to the next or previous workspace"
msgstr "Ir al espacio de trabajo siguiente o anterior"

msgid "Go to a workspace"
msgstr "Ir a un espacio de trabajo"

msgid "Move the window to a workspace"
msgstr "Mover la ventana a un espacio de trabajo"

msgid "Apps"
msgstr "Aplicaciones"

msgid "Terminal"
msgstr "Terminal"

msgid "Files"
msgstr "Archivos"

msgid "System monitor"
msgstr "Monitor del sistema"

msgid "Turn the screen reader on or off"
msgstr "Activar o desactivar el lector de pantalla"

msgid "Zoom in and out"
msgstr "Acercar y alejar"

msgid "Your system is installed and ready. Where do you come from? The tour adapts to you."
msgstr "Tu sistema está instalado y listo. ¿De dónde vienes? El recorrido se adapta a ti."

msgid "Make it yours"
msgstr "A tu gusto"

msgid "What do you use your computer for?"
msgstr "¿Para qué usas tu ordenador?"

msgid "Pick what concerns you: nothing installs without a click, and everything can be removed later."
msgstr "Marca lo que te interesa: nada se instala sin un clic, y todo se puede quitar después."

msgid "Thousands of other apps are in COSMIC Store."
msgstr "Miles de aplicaciones más están en COSMIC Store."

msgid "Your computer"
msgstr "Tu ordenador"

msgid "Checked for you: only what concerns this computer shows up."
msgstr "Comprobado para ti: solo aparece lo que afecta a este ordenador."

msgid "Try it, it is safe"
msgstr "Pruébalo, no hay riesgo"

msgid "Each button does the real thing."
msgstr "Cada botón lo hace de verdad."

msgid "The Keyboard shortcuts app lists them all."
msgstr "La aplicación Atajos de teclado los muestra todos."

msgid "Bring your things"
msgstr "Trae tus cosas"

msgid "Your files, bookmarks and email from before."
msgstr "Tus archivos, marcadores y correo de antes."

msgid "Files from an old disk"
msgstr "Archivos de un disco antiguo"

msgid "Plug it in: it shows up in Files, on the left. A Windows partition of this computer too."
msgstr "Conéctalo: aparece en Archivos, a la izquierda. Una partición de Windows de este ordenador también."

msgid "Open Files"
msgstr "Abrir Archivos"

msgid "Photos from a phone"
msgstr "Fotos de un móvil"

msgid "Plug it in with its cable and allow file transfer on the phone: it shows up in Files."
msgstr "Conéctalo con su cable y permite la transferencia de archivos en el móvil: aparece en Archivos."

msgid "Bookmarks and passwords"
msgstr "Marcadores y contraseñas"

msgid "Export them from your old browser (an HTML file for bookmarks, a CSV file for passwords), then import them in Firefox."
msgstr "Expórtalos desde tu antiguo navegador (un archivo HTML para los marcadores, un archivo CSV para las contraseñas) y luego impórtalos en Firefox."

msgid "Open Firefox"
msgstr "Abrir Firefox"

msgid "Email"
msgstr "Correo"

msgid "Thunderbird sets up your account with just your address and password."
msgstr "Thunderbird configura tu cuenta solo con tu dirección y tu contraseña."

msgid "Open Thunderbird"
msgstr "Abrir Thunderbird"

msgid "Good to know"
msgstr "Conviene saber"

msgid "Three things that work differently here."
msgstr "Tres cosas que aquí funcionan de otra manera."

msgid "Updates apply at the next restart"
msgstr "Las actualizaciones se aplican en el siguiente reinicio"

msgid "The system updates itself in the background, without interrupting you. Something wrong after an update? Go back to the previous version in one click."
msgstr "El sistema se actualiza solo en segundo plano, sin interrumpirte. ¿Algo falla tras una actualización? Vuelve a la versión anterior con un clic."

msgid "Updates"
msgstr "Actualizaciones"

msgid "An app cannot see a folder or a USB drive?"
msgstr "¿Una aplicación no ve una carpeta o una memoria USB?"

msgid "Apps run apart from the system and only see what they need. Flatseal gives them access to more."
msgstr "Las aplicaciones se ejecutan aparte del sistema y solo ven lo que necesitan. Flatseal les da acceso a más."

msgid "Open Flatseal"
msgstr "Abrir Flatseal"

msgid "A downloaded .exe, .deb or .rpm file?"
msgstr "¿Un archivo .exe, .deb o .rpm descargado?"

msgid "They do not install on cosmic-blue: look for the app in COSMIC Store, where it updates by itself."
msgstr "No se instalan en cosmic-blue: busca la aplicación en COSMIC Store, donde se actualiza sola."

msgid "You are ready"
msgstr "Ya estás listo"

msgid "One more thing worth doing: backups."
msgstr "Una cosa más que merece la pena: las copias de seguridad."

msgid "What changes, and what stays the same."
msgstr "Lo que cambia y lo que sigue igual."

msgid "Windows key → the Super key"
msgstr "Tecla Windows → la tecla Super"

msgid "It opens the launcher, like the Start menu: type the name of an app"
msgstr "Abre el lanzador, como el menú Inicio: escribe el nombre de una aplicación"

msgid "Microsoft Store → COSMIC Store"
msgstr "Microsoft Store → COSMIC Store"

msgid "Apps install and update from there"
msgstr "Las aplicaciones se instalan y actualizan desde allí"

msgid "File Explorer → Files"
msgstr "Explorador de archivos → Archivos"

msgid "Super + E opens it, as on Windows"
msgstr "Super + E lo abre, como en Windows"

msgid "Settings and Control Panel → Settings"
msgstr "Configuración y Panel de control → Configuración"

msgid "Everything in one place"
msgstr "Todo en un solo lugar"

msgid "Office → LibreOffice"
msgstr "Office → LibreOffice"

msgid "It opens and saves Word, Excel and PowerPoint files"
msgstr "Abre y guarda archivos de Word, Excel y PowerPoint"

msgid "Same as on Windows"
msgstr "Igual que en Windows"

msgid "Alt + Tab, Ctrl + C and Ctrl + V, Super + Shift + S for a screenshot, Ctrl + Shift + Esc for the task manager"
msgstr "Alt + Tab, Ctrl + C y Ctrl + V, Super + Mayús + S para una captura, Ctrl + Mayús + Esc para el administrador de tareas"

msgid "Command key → Ctrl, most of the time"
msgstr "Tecla Comando → Ctrl, casi siempre"

msgid "Copy, paste, save: Ctrl + C, Ctrl + V, Ctrl + S"
msgstr "Copiar, pegar, guardar: Ctrl + C, Ctrl + V, Ctrl + S"

msgid "Spotlight → the Super key"
msgstr "Spotlight → la tecla Super"

msgid "Super opens the launcher: type the name of an app"
msgstr "Super abre el lanzador: escribe el nombre de una aplicación"

msgid "App Store → COSMIC Store"
msgstr "App Store → COSMIC Store"

msgid "Finder → Files"
msgstr "Finder → Archivos"

msgid "Super + E opens it"
msgstr "Super + E lo abre"

msgid "Mission Control → Super + W"
msgstr "Mission Control → Super + W"

msgid "Your windows and workspaces at a glance"
msgstr "Tus ventanas y espacios de trabajo de un vistazo"

msgid "System Settings → Settings"
msgstr "Ajustes del Sistema → Configuración"

msgid "Everything in one place, Settings → Desktop for the look"
msgstr "Todo en un solo lugar, Configuración → Escritorio para la apariencia"

msgid "cosmic-blue in a nutshell"
msgstr "cosmic-blue en pocas palabras"

msgid "Fedora Atomic with COSMIC: the system is a signed, read-only image that updates as a whole. Apps and tools go on top of it."
msgstr "Fedora Atomic con COSMIC: el sistema es una imagen firmada, de solo lectura, que se actualiza entera. Las aplicaciones y herramientas van encima."

msgid "Tiling: Super + Y. The Keyboard shortcuts app lists them all."
msgstr "Mosaico: Super + Y. La aplicación Atajos de teclado los muestra todos."

msgid "The system's recipes: developer tools, command line tools, update channel… Type ujust to list them."
msgstr "Las recetas del sistema: herramientas de desarrollo, de línea de comandos, canal de actualizaciones… Escribe ujust para verlas."

msgid "Follow the stable (weekly), testing (daily) or dev image"
msgstr "Seguir la imagen stable (semanal), testing (diaria) o dev"
