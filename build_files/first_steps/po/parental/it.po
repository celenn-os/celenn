# Italian translation of cosmic-blue Parental controls
# (build_files/first_steps/src/parental.rs).
msgid ""
msgstr ""
"Language: it\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "Parental controls"
msgstr "Controllo parentale"

msgid "Choose how long and when your children can use this computer."
msgstr "Scegli per quanto tempo e quando i tuoi figli possono usare questo computer."

msgid "Child accounts"
msgstr "Account dei figli"

msgid "Other accounts"
msgstr "Altri account"

msgid "Administrator · no limits"
msgstr "Amministratore · nessun limite"

msgid "No limits"
msgstr "Nessun limite"

msgid "Today: {} of {}"
msgstr "Oggi: {} su {}"

msgid "Today: {}"
msgstr "Oggi: {}"

msgid "Add a child account"
msgstr "Aggiungi un account per un figlio"

msgid "An account without administrator rights, ready in one click"
msgstr "Un account senza diritti di amministratore, pronto con un clic"

msgid "Add…"
msgstr "Aggiungi…"

msgid "Only a parent (an administrator account) can change these settings."
msgstr "Solo un genitore (account amministratore) può modificare queste impostazioni."

msgid "Back"
msgstr "Indietro"

msgid "Screen time"
msgstr "Tempo di utilizzo"

msgid "Limit screen time"
msgstr "Limita il tempo di utilizzo"

msgid "Only time in front of the screen counts. Warnings 10, 5 and 1 minutes before the end."
msgstr "Conta solo il tempo davanti allo schermo. Avvisi 10, 5 e 1 minuto prima della fine."

msgid "Monday to Friday"
msgstr "Dal lunedì al venerdì"

msgid "Saturday and Sunday"
msgstr "Sabato e domenica"

msgid "Bedtime"
msgstr "Ora di dormire"

msgid "No computer at night"
msgstr "Niente computer di notte"

msgid "The session closes and logging in is refused during these hours."
msgstr "La sessione si chiude e l'accesso è negato in queste ore."

msgid "From"
msgstr "Dalle"

msgid "To"
msgstr "Alle"

msgid "Internet"
msgstr "Internet"

msgid "Block unsuitable websites"
msgstr "Blocca i siti non adatti"

msgid "Adult content, gambling and malicious sites, in every browser. Safe search is forced. Uses the CleanBrowsing family filter."
msgstr "Contenuti per adulti, gioco d'azzardo e siti dannosi, in ogni browser. La ricerca sicura è forzata. Usa il filtro famiglia di CleanBrowsing."

msgid "This week"
msgstr "Questa settimana"

msgid "Average: {} a day"
msgstr "Media: {} al giorno"

msgid "Mon"
msgstr "lun"

msgid "Tue"
msgstr "mar"

msgid "Wed"
msgstr "mer"

msgid "Thu"
msgstr "gio"

msgid "Fri"
msgstr "ven"

msgid "Sat"
msgstr "sab"

msgid "Sun"
msgstr "dom"

msgid "{h} h {m} min"
msgstr "{h} h {m} min"

msgid "{h} h"
msgstr "{h} h"

msgid "{m} min"
msgstr "{m} min"

msgid "Name"
msgstr "Nome"

msgid "Password"
msgstr "Password"

msgid "The child logs in with this name and password."
msgstr "Il bambino accede con questo nome e questa password."

msgid "Create"
msgstr "Crea"

msgid "Cancel"
msgstr "Annulla"

msgid "Recommended"
msgstr "Consigliato"

msgid "More time for {}"
msgstr "Più tempo per {}"

msgid "A parent confirms with their password."
msgstr "Un genitore conferma con la sua password."

msgid "+15 min"
msgstr "+15 min"

msgid "+30 min"
msgstr "+30 min"

msgid "+60 min"
msgstr "+60 min"

msgid "Give"
msgstr "Concedi"

msgid "{} minutes left"
msgstr "Mancano {} minuti"

msgid "1 minute left"
msgstr "Manca 1 minuto"

msgid "Your session closes at {}. Save your work."
msgstr "La tua sessione si chiude alle {}. Salva il tuo lavoro."

msgid "Ask for more time"
msgstr "Chiedi più tempo"

msgid "It is bedtime."
msgstr "È ora di dormire."

msgid "Screen time is over for today."
msgstr "Il tempo di utilizzo per oggi è finito."

msgid "You can log in again at {}."
msgstr "Potrai accedere di nuovo alle {}."

msgid "You can log in again tomorrow."
msgstr "Potrai accedere di nuovo domani."

msgid "You can log in again tomorrow at {}."
msgstr "Potrai accedere di nuovo domani alle {}."

msgid "Type a duration, for example 45 or 1:20."
msgstr "Inserisci una durata, per esempio 45 o 1:20."

msgid "Type a time, for example 20:45."
msgstr "Inserisci un orario, per esempio 20:45."

msgid "Parental controls do not allow logging in now. Ask a parent."
msgstr "Il controllo parentale non permette di accedere adesso. Chiedi a un genitore."

msgid "No limit today"
msgstr "Nessun limite oggi"

msgid "Saving the settings"
msgstr "Salvare le impostazioni"

msgid "“{}” did not work"
msgstr "«{}» non è riuscito"

msgid "No internet connection. Connect to a network, then try again. Nothing was changed."
msgstr "Nessuna connessione a Internet. Collegatevi a una rete, poi riprovate. Non è stato modificato nulla."

msgid "The disk is full ({} free). Free up space with Clean up, in cosmic-blue Tools, Maintenance, then try again."
msgstr "Il disco è pieno ({} liberi). Liberate spazio con Pulisci, in Strumenti di cosmic-blue, Manutenzione, poi riprovate."

msgid "The server does not answer. Try again in a few minutes."
msgstr "Il server non risponde. Riprovate tra qualche minuto."

msgid "Something unexpected went wrong. Nothing was changed."
msgstr "Qualcosa di inatteso è andato storto. Non è stato modificato nulla."

msgid "Try again"
msgstr "Riprova"

msgid "Network settings"
msgstr "Impostazioni di rete"

msgid "Report the problem"
msgstr "Segnala il problema"

msgid "Technical details"
msgstr "Dettagli tecnici"

msgid "The report opens in your browser, filled in: the cosmic-blue version, the hardware and this error. No files or personal data. You read it before sending it; write in your own language. Sending needs a GitHub account."
msgstr "Il rapporto si apre nel browser, già compilato: la versione di cosmic-blue, l'hardware e questo errore. Nessun file né dato personale. Lo rileggete prima di inviarlo; scrivete nella vostra lingua. Per inviarlo serve un account GitHub."

msgid "Open the report"
msgstr "Apri il rapporto"

msgid "Close"
msgstr "Chiudi"

msgid "Applications"
msgstr "Applicazioni"

msgid "Applications validated by a parent"
msgstr "Applicazioni approvate da un genitore"

msgid "{} only uses the applications you ticked. Installing an application needs a parent's password."
msgstr "{} usa solo le applicazioni che hai spuntato. Per installare un'applicazione serve la password di un genitore."

msgid "Allowed applications"
msgstr "Applicazioni consentite"

msgid "{} of {}"
msgstr "{} su {}"

msgid "Choose…"
msgstr "Scegli…"

msgid "Downloaded programs (AppImages, executable files) do not run on this account."
msgstr "I programmi scaricati (AppImage, file eseguibili) non si avviano su questo account."

msgid "Applications of {}"
msgstr "Applicazioni di {}"

msgid "Search for an application"
msgstr "Cerca un'applicazione"

msgid "Allowed"
msgstr "Consentite"

msgid "Blocked"
msgstr "Bloccate"

msgid "Applications installed later are blocked until you tick them."
msgstr "Le applicazioni installate in seguito restano bloccate finché non le spunti."

msgid "{} is not allowed"
msgstr "L'applicazione {} non è consentita"

msgid "A parent must allow it first in Parental controls."
msgstr "Un genitore deve prima consentirla nel Controllo parentale."

msgid "Program blocked"
msgstr "Programma bloccato"

msgid "«{}» cannot run on this account: downloaded programs are not allowed."
msgstr "«{}» non può avviarsi su questo account: i programmi scaricati non sono consentiti."
