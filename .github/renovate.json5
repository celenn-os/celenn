{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Etc/UTC",

  // Merge non-major updates once every check of the pull request is green
  // (image build + VM boot test). Renovate merges them itself:
  // GitHub's native auto-merge would merge at once, as main has no required
  // status checks.
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,

  "packageRules": [
    {
      // Container images are followed by tag, not pinned by digest: base
      // images are rebuilt every day, and a digest pin would mean one more
      // pull request and one more image build each day for the same result
      // as the daily build. Tag updates (rare: Fedora moves are turned off
      // below) come as one grouped pull request.
      "description": "Container images in the Containerfile, by tag only",
      "matchManagers": ["dockerfile"],
      "pinDigests": false,
      "groupName": "base images",
      "schedule": ["* 4 * * *"]
    },
    {
      "description": "GitHub Actions, once a week",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions",
      "schedule": ["* 0-7 * * 1"]
    },
    {
      // Moving to a new Fedora release is a deliberate choice (see the
      // Containerfile): never propose it.
      "description": "Stay on the current Fedora release",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/ublue-os/base-main",
        "registry.fedoraproject.org/fedora"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Tela circle icons (no releases: latest master commit), once a week",
      "matchDepNames": ["https://github.com/vinceliuice/Tela-circle-icon-theme.git"],
      "groupName": "Tela circle icons",
      "schedule": ["* 0-7 * * 1"]
    },
    {
      "description": "titanoboa, the live ISO builder (no releases: latest main commit), once a week",
      "matchDepNames": ["https://github.com/ublue-os/titanoboa"],
      "groupName": "titanoboa",
      "schedule": ["* 0-7 * * 1"]
    },
    {
      // Major versions can break the build: open the pull request, a human
      // merges it.
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],

  // Tela circle is fetched by git at a pinned commit in
  // build_files/icon_theme/tela.sh, the Bibata cursors at a pinned tag in
  // build_files/cursor_theme/bibata.sh, Starship at a pinned release in
  // build_files/30-packages.sh, titanoboa at a pinned commit in
  // .github/workflows/build-live-iso.yml
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/30-packages\\.sh$/"],
      "matchStrings": [
        "STARSHIP_REPO=\"https://github\\.com/(?<depName>[^\"]+)\"\\s+STARSHIP_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/icon_theme/tela\\.sh$/"],
      "matchStrings": [
        "TELA_REPO=\"(?<depName>[^\"]+)\"\\s+TELA_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "master"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/cursor_theme/bibata\\.sh$/"],
      "matchStrings": [
        "BIBATA_REPO=\"https://github\\.com/(?<depName>[^\"]+)\\.git\"\\s+BIBATA_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/build-live-iso\\.yml$/"],
      "matchStrings": [
        "TITANOBOA_REPO: \"(?<depName>[^\"]+)\"\\s+TITANOBOA_REF: \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],

  // libcosmic (and the theme tool's Cargo.lock) follows the Fedora COSMIC
  // packages through .github/workflows/check-cosmic-version.yml, not Renovate.
  "cargo": { "enabled": false }
}
