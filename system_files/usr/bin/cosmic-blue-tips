#!/usr/bin/bash
# Print one random cosmic-blue tip, in Markdown, for the terminal welcome
# banner (uwelcome, see /etc/uwelcome/config.toml). Replaces Bluefin's umotd,
# whose tips are about Bluefin, GNOME and apps cosmic-blue does not ship.
#
# The tips are in /usr/share/cosmic-blue/tips, one file per language (en.txt,
# fr.txt, pt_BR.txt for a regional variant...), one tip per line, with @DOCS@
# for the documentation link. The file is picked from the messages locale,
# like gettext does; English when there is none. To add a language, add its
# file with the same tips in the same order.
set -euo pipefail

dir="${COSMIC_BLUE_TIPS_DIR:-/usr/share/cosmic-blue/tips}"
site="https://cosmic-blue-os.github.io/cosmic-blue/"

# The file of a locale name (de_CH.UTF-8): same language and region, else
# same language, else another region of that language
tips_file() {
    local name="${1%%[.@]*}" lang candidate
    lang="${name%%_*}"
    for candidate in "${dir}/${name}.txt" "${dir}/${lang}.txt" "${dir}/${lang}"_*.txt; do
        if [[ -f "${candidate}" ]]; then
            printf '%s\n' "${candidate}"
            return 0
        fi
    done
    return 1
}

file=""
IFS=: read -r -a names <<< "${LANGUAGE:-}"
names+=("${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}")
for name in "${names[@]}"; do
    [[ -n "${name}" ]] || continue
    if file="$(tips_file "${name}")"; then
        break
    fi
    file=""
    [[ "${name}" == en* || "${name}" == C* || "${name}" == POSIX ]] && break
done
[[ -n "${file}" ]] || file="${dir}/en.txt"

# The site's documentation is in English and French
docs="${site}docs/"
[[ "$(basename "${file}")" == fr* ]] && docs="${site}fr/docs/"

mapfile -t tips < <(grep -v '^[[:space:]]*$' "${file}")
printf '%s\n' "${tips[RANDOM % ${#tips[@]}]//@DOCS@/${docs}}"
