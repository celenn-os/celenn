#!/usr/bin/bash
# Gives COSMIC the keyboard layout and clock format chosen in the installer.
#
# Anaconda stores them system-wide (/etc/X11/xorg.conf.d/00-keyboard.conf,
# /etc/vconsole.conf, /etc/locale.conf), but cosmic-greeter and cosmic-comp
# only read each user's COSMIC settings, which cosmic-initial-setup would
# normally write. Without them the login screen and the session use a US
# QWERTY layout and a 12-hour clock.
#
# Runs before the login screen at every boot. For users it only creates
# settings that are missing, so a user's own choices are never overwritten.
# Each account's settings are written by the account itself (--user, through
# runuser), never by root: a home directory is the user's to arrange, and
# root following a symbolic link planted there could write anywhere.
set -euo pipefail

XKB_KEY=com.system76.CosmicComp/v1/xkb_config
TIME_KEY=com.system76.CosmicAppletTime/v1/military_time
WEEK_KEY=com.system76.CosmicAppletTime/v1/first_day_of_week

layout="" model="" variant="" options=""

# 1. X11 keyboard settings written by Anaconda or localectl
if [[ -f /etc/X11/xorg.conf.d/00-keyboard.conf ]]; then
    xkb_option() {
        sed -n "s/^[[:space:]]*Option[[:space:]]*\"$1\"[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
            /etc/X11/xorg.conf.d/00-keyboard.conf | head -n 1
    }
    layout="$(xkb_option XkbLayout)"
    model="$(xkb_option XkbModel)"
    variant="$(xkb_option XkbVariant)"
    options="$(xkb_option XkbOptions)"
fi

# 2. Otherwise, the console keymap translated with systemd's map
if [[ -z "${layout}" && -f /etc/vconsole.conf ]]; then
    keymap="$(sed -n 's/^KEYMAP="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/vconsole.conf | head -n 1)"
    if [[ -n "${keymap}" && -f /usr/share/systemd/kbd-model-map ]]; then
        read -r _ layout model variant options < <(
            awk -v km="${keymap}" '$1 == km { print; exit }' /usr/share/systemd/kbd-model-map
        ) || true
        [[ "${variant}" == "-" ]] && variant=""
        [[ "${options}" == "-" ]] && options=""
    fi
fi

# 24-hour clock and weeks starting on Monday, unless the language is US English
lang="$(sed -n 's/^LANG="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/locale.conf 2>/dev/null | head -n 1)"
military_time=true
[[ "${lang}" == en_US* || -z "${lang}" ]] && military_time=false

xkb_config=""
if [[ -n "${layout}" && "${layout}" != "us" ]] || [[ -n "${variant}" ]]; then
    if [[ -n "${options}" ]]; then options_ron="Some(\"${options}\")"; else options_ron="None"; fi
    xkb_config="(
    rules: \"\",
    model: \"${model}\",
    layout: \"${layout}\",
    variant: \"${variant}\",
    options: ${options_ron},
    repeat_delay: 600,
    repeat_rate: 25,
)"
fi

# Writes a setting in a COSMIC config dir if it is not there yet
# (-L: a dangling symbolic link counts as there)
write_missing() { # config_dir key value
    local file="$1/$2"
    [[ -n "$3" && ! -e "${file}" && ! -L "${file}" ]] || return 0
    install -d -m 0755 "$(dirname "${file}")"
    printf '%s' "$3" >"${file}"
}

configure() { # home
    local dir="$1/.config/cosmic" time_value="" week_value=""
    [[ -d "$1/.config" ]] || install -d -m 0700 "$1/.config"
    if [[ "${military_time}" == true ]]; then
        time_value=true
        week_value=0
    fi
    write_missing "${dir}" "${XKB_KEY}" "${xkb_config}"
    write_missing "${dir}" "${TIME_KEY}" "${time_value}"
    write_missing "${dir}" "${WEEK_KEY}" "${week_value}"
}

# One account, run as that account (see the top of this file)
if [[ "${1:-}" == --user ]]; then
    configure "${HOME}"
    exit 0
fi

# The login screen itself: cosmic-greeter runs its own cosmic-comp as the
# cosmic-greeter user, and that compositor's keymap is what the password
# field types with. This copy follows the system layout, so it is rewritten
# whenever it differs.
if [[ -n "${xkb_config}" ]] && greeter="$(getent passwd cosmic-greeter)"; then
    greeter_home="$(cut -d: -f6 <<<"${greeter}")"
    greeter_owner="$(cut -d: -f3,4 <<<"${greeter}")"
    greeter_file="${greeter_home}/.config/cosmic/${XKB_KEY}"
    if [[ -d "${greeter_home}" && "$(cat "${greeter_file}" 2>/dev/null)" != "${xkb_config}" ]]; then
        install -d -m 0755 -o "${greeter_owner%%:*}" -g "${greeter_owner##*:}" \
            "${greeter_home}/.config" "${greeter_home}/.config/cosmic" \
            "${greeter_home}/.config/cosmic/com.system76.CosmicComp" \
            "$(dirname "${greeter_file}")"
        printf '%s' "${xkb_config}" >"${greeter_file}"
        chown "${greeter_owner}" "${greeter_file}"
    fi
fi

# Future users
configure /etc/skel

# Existing users (regular UIDs, home under /home), each with its own rights
while IFS=: read -r name _ uid _ _ home _; do
    if (( uid >= 1000 && uid < 60000 )) && [[ "${home}" == /home/* || "${home}" == /var/home/* ]] \
        && [[ -d "${home}" ]]; then
        runuser -u "${name}" -- env -i HOME="${home}" USER="${name}" LOGNAME="${name}" \
            PATH=/usr/bin:/usr/sbin "$0" --user ||
            echo "Account ${name}: could not apply the installer settings"
    fi
done < <(getent passwd)
