#!/usr/bin/bash
# Print the system details that a cosmic-blue bug report needs, as plain
# "Name: value" lines (used by `ujust bug-report`).
#
# No personal data: no user or host name, no serial numbers, no network
# addresses, no file paths of the home folder. Runs as any user.
set -uo pipefail

line() { # name value...
    local name="$1" value
    shift
    value="$*"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s: %s\n' "${name}" "${value:-unknown}"
}

os_release() { # key
    (. /usr/lib/os-release && printf '%s' "${!1:-}") 2>/dev/null
}

# Image and deployments: rpm-ostree reads them without root
status="$(timeout 30 rpm-ostree status --json 2>/dev/null || true)"
deployment() { # jq filter selecting one deployment
    jq -r "[.deployments[] | select($1)][0] // empty
        | (.version // \"?\") + \"  \" + (.\"container-image-reference\" // .origin // \"?\")
          + (if .\"container-image-reference-digest\" then \"  \" + .\"container-image-reference-digest\" else \"\" end)" \
        <<<"${status}" 2>/dev/null
}
layered() {
    jq -r '[.deployments[] | select(.booted)][0] // {}
        | [(."requested-packages" // [])[], (."requested-local-packages" // [])[]]
        + [(."requested-base-removals" // [])[] | "-" + .]
        + [(."requested-base-local-replacements" // [])[] | "~" + .]
        | if length == 0 then "none" else join(" ") end' <<<"${status}" 2>/dev/null
}

line "Image" "$(os_release IMAGE_ID) $(os_release IMAGE_VERSION)"
if [[ -n "${status}" ]]; then
    line "Booted" "$(deployment '.booted')"
    staged="$(deployment '.staged')"
    line "Staged update" "${staged:-none}"
    rollback="$(deployment '(.booted | not) and (.staged | not)')"
    line "Rollback" "${rollback:-none}"
    line "Layered packages" "$(layered)"
else
    line "Booted" "not an installed system (live ISO?)"
fi
line "Kernel" "$(uname -r)"
line "COSMIC" "$(rpm -q --qf '%{VERSION}-%{RELEASE}' cosmic-session 2>/dev/null || true)"

# Hardware
line "Computer" "$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null | tr '\n' ' ')"
line "CPU" "$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -n 1) ($(nproc) threads)"
line "Memory" "$(awk '/^MemTotal:/ {printf "%.1f GiB", $2 / 1048576}' /proc/meminfo)"
gpus=()
for card in /sys/class/drm/card[0-9]; do
    [[ -e "${card}/device" ]] || continue
    slot="$(basename "$(readlink -f "${card}/device")")"
    driver="$(basename "$(readlink -f "${card}/device/driver" 2>/dev/null)" 2>/dev/null)"
    name=""
    if command -v lspci >/dev/null; then
        name="$(lspci -s "${slot}" -mm 2>/dev/null | awk -F'"' '{print $4 " " $6}')"
    fi
    [[ -n "${name}" ]] || name="$(cat "${card}/device/vendor" "${card}/device/device" 2>/dev/null | xargs | tr ' ' ':')"
    gpus+=("${name} [driver: ${driver:-none}]")
done
if [[ "${#gpus[@]}" -eq 0 ]]; then
    line "GPU" "none found"
fi
for gpu in "${gpus[@]}"; do
    line "GPU" "${gpu}"
done
if [[ -r /sys/module/nvidia/version ]]; then
    line "NVIDIA driver" "$(cat /sys/module/nvidia/version)"
fi
# /var holds the home folders and the apps, on the same disk as the system
line "Free disk space" "$(df -h --output=avail /var 2>/dev/null | tail -n 1)"
line "Virtual machine" "$(systemd-detect-virt 2>/dev/null || echo no)"
if [[ -d /sys/firmware/efi ]]; then
    line "Firmware" "UEFI, $(mokutil --sb-state 2>/dev/null | head -n 1 || echo 'Secure Boot state unknown')"
else
    line "Firmware" "BIOS (legacy)"
fi

# Session and system state
line "Session" "${XDG_CURRENT_DESKTOP:-none} ${XDG_SESSION_TYPE:-}"
line "Language" "${LANG:-unset}"
failed="$(timeout 10 systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | xargs)"
line "Failed system services" "${failed:-none}"
failed_user="$(timeout 10 systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | xargs)"
line "Failed user services" "${failed_user:-none}"
