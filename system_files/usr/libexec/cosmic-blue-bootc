#!/usr/bin/bash
# bootc as uupd runs it (UUPD_BOOTC_BINARY, set in uupd.service.d and
# uupd-manual.service.d): the same, except that the automatic updates do not
# install again a version left behind with "Go back" in the Updates app.
#
# When the Updates app goes back to the previous version, its helper
# (cosmic-blue-updates-helper) writes the digest and version of the version
# left behind to /var/lib/cosmic-blue/update-hold. While the registry still
# serves that same image, `upgrade` reports no update; once a newer image is
# out, the note is removed and updates go on as usual. Every other command
# goes straight to bootc.
#
# Downloads (`upgrade` without --check, `switch`, also run by
# cosmic-blue-updates-helper) copy bootc's progress, JSON lines written to
# --progress-fd, to /run/cosmic-blue/update-progress.jsonl, readable by
# everyone, while bootc runs: the Updates app shows a progress bar from it. uupd reads that
# progress itself on fd 3: it gets the same lines.
set -euo pipefail

BOOTC=/usr/bin/bootc
HOLD=/var/lib/cosmic-blue/update-hold
PROGRESS=/run/cosmic-blue/update-progress.jsonl

# Runs bootc and exits with its status, copying the progress of a download
# (the copy is removed when bootc ends, which hides the bar)
run_bootc() {
    local download=false status=0
    case "${1:-}" in
        upgrade) [[ " $* " == *" --check "* ]] || download=true ;;
        switch) download=true ;;
    esac
    if [[ "${download}" != true ]] || ! { mkdir -p "${PROGRESS%/*}" && : > "${PROGRESS}"; }; then
        exec "${BOOTC}" "$@"
    fi
    chmod 0644 "${PROGRESS}"
    if [[ " $* " == *" --progress-fd 3 "* ]]; then
        # uupd's pipe stays on fd 4 for the copy
        exec 4>&3
        "${BOOTC}" "$@" 3> >(tee -a "${PROGRESS}" >&4) || status=$?
    else
        # bootc wants a pipe there
        "${BOOTC}" "$@" --progress-fd 3 3> >(cat >> "${PROGRESS}") || status=$?
    fi
    rm -f "${PROGRESS}"
    exit "${status}"
}

if [[ "${1:-}" != upgrade || ! -s "${HOLD}" ]]; then
    run_bootc "$@"
fi

read -r held version < "${HOLD}" || true
booted="$("${BOOTC}" status --json | jq -r '.status.booted.image.imageDigest // empty')" || booted=""
if [[ -z "${held:-}" || "${booted}" == "${held}" ]]; then
    # Running the version that was set aside after all: nothing to hold
    rm -f "${HOLD}"
    run_bootc "$@"
fi

# What the registry serves now (only its manifest is downloaded)
if ! check="$("${BOOTC}" upgrade --check 2>&1)"; then
    # Offline or registry error: let bootc report it
    run_bootc "$@"
fi
# The digest found, from bootc's status (JSON: the check caches it), else
# from what the check printed
available="$("${BOOTC}" status --json 2>/dev/null \
    | jq -r '.status.booted.cachedUpdate.imageDigest // empty')" || available=""
if [[ -z "${available}" ]]; then
    available="$(sed -n 's/^  Digest: //p' <<<"${check}" | head -n 1)"
fi
if [[ "${available}" == "${held}" ]]; then
    image="$("${BOOTC}" status --json 2>/dev/null | jq -r '.spec.image.image // empty')" || image=""
    [[ -n "${image}" ]] || image="$(sed -n 's/^Update available for: //p' <<<"${check}" | head -n 1)"
    # The words uupd looks for when it checks for an update
    echo "No changes in: ${image} (version ${version:-?} was set aside after going back to the previous one)"
    exit 0
fi
# A newer image (or none at all): the version set aside is behind us
[[ -z "${available}" ]] || rm -f "${HOLD}"
if [[ " $* " == *" --check "* ]]; then
    echo "${check}"
    exit 0
fi
run_bootc "$@"
