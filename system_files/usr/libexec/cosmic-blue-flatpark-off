#!/usr/bin/bash
# Runs once per system. cosmic-blue images before this change added the
# FlatPark Flatpak remote on their own; it is now off by default and turned
# on with `ujust toggle-flatpark`.
# - FlatPark on, no app installed from it: the remote is removed.
# - Apps installed from FlatPark: the remote stays, so they keep getting
#   updates, but at the lowest priority, after Flathub and COSMIC.
# Afterwards the choice is the user's: this does not run again.
set -euo pipefail

STAMP=/var/lib/cosmic-blue/flatpark-off-done

if flatpak remotes --system --columns=name | grep -qx flatpark; then
    apps="$(flatpak list --system --columns=application,origin | awk '$2 == "flatpark" {print $1}')"
    if [[ -n "${apps}" ]]; then
        echo "Apps installed from FlatPark, keeping it at the lowest priority:" ${apps}
        flatpak remote-modify --system --prio=0 flatpark
    else
        echo "Removing the FlatPark remote (no app installed from it)"
        flatpak remote-delete --system flatpark
        rm -f /var/lib/flatpak/repo/flatpark.filter
    fi
fi

install -d "$(dirname "${STAMP}")"
touch "${STAMP}"
