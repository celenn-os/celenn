#!/usr/bin/bash
# Carries the settings and data of a system installed as cosmic-blue over to
# the names of Celenn OS, the project's new name, so that nothing is lost:
#
#   system (as root, at boot, before the login screen and the services that
#   read them):
#     - /etc/cosmic-blue and /var/lib/cosmic-blue (parental controls rules and
#       usage, update hold...) move to /etc/celenn and /var/lib/celenn, with
#       the ids of our apps in them renamed
#     - the group of the child accounts, cosmic-blue-children, becomes
#       celenn-children (same members)
#     - disks set up in Celenn OS Tools keep their mark in /etc/fstab
#   each account (as the account itself):
#     - ~/.config/cosmic-blue and ~/.local/state/cosmic-blue move to
#       ~/.config/celenn and ~/.local/state/celenn
#     - COSMIC settings that name a renamed thing follow it: launchers of our
#       apps (dock, App Library), shortcuts, wallpapers, icon, cursor and
#       terminal themes, the App Library group
#     - the GTK icon and cursor themes (GSettings) likewise
#
# Each step only acts on what still has an old name, so running it again does
# nothing. Remove in the cleanup after the rename (with the compatibility
# link /usr/lib64/security/pam_cosmic_blue_parental.so).
#
# Usage:
#   celenn-migrate-names          as root, at boot: the system, then every account
#   celenn-migrate-names --user   the current account ($HOME)
set -euo pipefail

OLD_APP_ID='io\.github\.cosmic_blue_os\.'
NEW_APP_ID='io.github.celenn_os.'

# Moves OLD to NEW. When NEW exists already, OLD's files that NEW lacks are
# moved into it, and OLD is removed.
move_dir() {
    local old="$1" new="$2"
    [[ -e "${old}" && ! -L "${old}" ]] || return 0
    if [[ ! -e "${new}" ]]; then
        mkdir -p "$(dirname "${new}")"
        mv "${old}" "${new}"
    else
        cp -a --update=none "${old}/." "${new}/"
        rm -rf "${old}"
    fi
    echo "Moved ${old} to ${new}"
}

# Renames our app ids in the regular files under DIR (or in FILE)
rename_app_ids() {
    [[ -e "$1" ]] || return 0
    grep -rlZ --exclude-dir=.git "${OLD_APP_ID}" "$1" 2>/dev/null |
        xargs -0 -r sed -i "s/${OLD_APP_ID}/${NEW_APP_ID}/g" || true
}

migrate_system() {
    # The group first: the parental controls service and the polkit and D-Bus
    # rules use the new name
    if getent group cosmic-blue-children >/dev/null; then
        if getent group celenn-children >/dev/null; then
            # Both exist (systemd-sysusers made the new one first): the old
            # one's members join the new one
            local member members
            members="$(getent group cosmic-blue-children | cut -d: -f4)"
            for member in ${members//,/ }; do
                gpasswd -a "${member}" celenn-children >/dev/null
            done
            groupdel cosmic-blue-children
        else
            groupmod -n celenn-children cosmic-blue-children
        fi
        echo "Renamed the group cosmic-blue-children to celenn-children"
    fi

    move_dir /etc/cosmic-blue /etc/celenn
    move_dir /var/lib/cosmic-blue /var/lib/celenn
    rename_app_ids /etc/celenn
    rename_app_ids /var/lib/celenn

    if grep -q 'x-cosmic-blue-disk' /etc/fstab 2>/dev/null; then
        sed -i 's/x-cosmic-blue-disk/x-celenn-disk/g' /etc/fstab
        systemctl daemon-reload || true
        echo "Renamed the disk marks in /etc/fstab"
    fi

    # Every account (regular UIDs, home under /home), each with its own rights
    local name uid home
    while IFS=: read -r name _ uid _ _ home _; do
        if ((uid >= 1000 && uid < 60000)) && [[ "${home}" == /home/* || "${home}" == /var/home/* ]] \
            && [[ -d "${home}" ]]; then
            runuser -u "${name}" -- env -i HOME="${home}" USER="${name}" LOGNAME="${name}" \
                PATH=/usr/bin:/usr/sbin "$0" --user ||
                echo "Account ${name}: could not move its settings to the new names"
        fi
    done < <(getent passwd)
}

migrate_user() {
    local config="${XDG_CONFIG_HOME:-${HOME}/.config}"
    local state="${XDG_STATE_HOME:-${HOME}/.local/state}"
    move_dir "${config}/cosmic-blue" "${config}/celenn"
    move_dir "${state}/cosmic-blue" "${state}/celenn"

    # COSMIC settings: only files that name an old thing are rewritten
    local cosmic="${config}/cosmic" file
    if [[ -d "${cosmic}" ]]; then
        while IFS= read -r -d '' file; do
            [[ -f "${file}" && ! -L "${file}" ]] || continue
            sed -i -E \
                -e "s/${OLD_APP_ID}/${NEW_APP_ID}/g" \
                -e 's#/usr/share/backgrounds/cosmic-blue/cosmic-blue#/usr/share/backgrounds/celenn/celenn#g' \
                -e 's#/usr/share/cosmic-blue/#/usr/share/celenn/#g' \
                -e 's#/usr/libexec/cosmic-blue-#/usr/libexec/celenn-#g' \
                -e 's/Bibata-Modern-cosmic-blue/Bibata-Modern-celenn/g' \
                -e 's/"cosmic-blue-/"celenn-/g' \
                "${file}"
            case "${file#"${cosmic}/"}" in
            com.system76.CosmicTk/* | com.system76.CosmicTheme.*/*)
                # The icon theme
                sed -i 's/"cosmic-blue"/"celenn"/g' "${file}" ;;
            com.system76.CosmicTerm/*)
                # The terminal color scheme
                sed -i 's/"cosmic-blue"/"Celenn"/g' "${file}" ;;
            com.system76.CosmicAppLibrary/*)
                sed -i 's/name: "cosmic-blue"/name: "Celenn OS"/g' "${file}" ;;
            esac
            echo "Settings moved to the new names: ${file#"${config}/"}"
        done < <(grep -rlZ -e 'cosmic_blue_os' -e 'cosmic-blue' "${cosmic}" 2>/dev/null)
    fi

    # GTK icon and cursor themes: no session yet at boot, dconf needs a bus of
    # its own
    command -v dconf >/dev/null || return 0
    local icons cursors
    icons="$(dconf read /org/gnome/desktop/interface/icon-theme 2>/dev/null || true)"
    cursors="$(dconf read /org/gnome/desktop/interface/cursor-theme 2>/dev/null || true)"
    local commands=()
    [[ "${icons}" == "'cosmic-blue'" ]] &&
        commands+=("dconf write /org/gnome/desktop/interface/icon-theme \"'celenn'\"")
    [[ "${cursors}" == "'Bibata-Modern-cosmic-blue'" ]] &&
        commands+=("dconf write /org/gnome/desktop/interface/cursor-theme \"'Bibata-Modern-celenn'\"")
    if [[ "${#commands[@]}" -gt 0 ]]; then
        dbus-run-session -- sh -c "$(printf '%s; ' "${commands[@]}")" ||
            echo "Could not rename the GTK icon and cursor themes"
    fi
}

case "${1:-}" in
--user)
    migrate_user
    ;;
"")
    migrate_system
    ;;
*)
    echo "Usage: $0 [--user]" >&2
    exit 1
    ;;
esac
