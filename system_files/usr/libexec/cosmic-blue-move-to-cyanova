#!/usr/bin/bash
# Moves systems that follow a cosmic-blue image to the same image under its
# new name, Cyanova, once that image is published.
#
# The project is renamed: the images move from ghcr.io/cosmic-blue-os/cosmic-blue
# (and cosmic-blue-nvidia) to ghcr.io/cyanova-os/cyanova (and cyanova-nvidia).
# An installed system keeps following the old name, which gets no new builds
# after the rename. This switches it to the new image, on the same channel
# (stable, testing, latest or dev), with the signature check on: the new
# namespace is signed with the same key (/etc/containers/policy.json). The
# image is downloaded and checked like an update and applies at the next
# reboot. Until the new image exists, it does nothing.
#
# Usage: cosmic-blue-move-to-cyanova [--dry-run]
set -euo pipefail

OLD_VENDOR="ghcr.io/cosmic-blue-os"
NEW_VENDOR="ghcr.io/cyanova-os"
dry_run=false
[[ "${1:-}" == --dry-run ]] && dry_run=true

spec="$(bootc status --json | jq -c '.spec.image // {}')"
image="$(jq -r '.image // empty' <<<"${spec}")"
transport="$(jq -r '.transport // empty' <<<"${spec}")"

if [[ "${transport}" != registry || "${image,,}" != "${OLD_VENDOR}/"* ]]; then
    echo "Not following a cosmic-blue image (${transport:-none}:${image:-none}): nothing to do"
    exit 0
fi

# ghcr.io/cosmic-blue-os/cosmic-blue-nvidia:stable -> ghcr.io/cyanova-os/cyanova-nvidia:stable
name_tag="${image#*/*/}"
name="${name_tag%%[:@]*}"
suffix="${name_tag#"${name}"}"
case "${name}" in
    cosmic-blue) new_name=cyanova ;;
    cosmic-blue-nvidia) new_name=cyanova-nvidia ;;
    *)
        echo "${image}: unknown image name, leaving it as it is" >&2
        exit 0
        ;;
esac
# A digest pins one build of the old image: keep the channel only
[[ "${suffix}" == :* ]] || suffix=":stable"
target="${NEW_VENDOR}/${new_name}${suffix}"

# The new namespace must be trusted, or the switch would be refused
if ! jq -e --arg vendor "${NEW_VENDOR}" '.transports.docker[$vendor][0].type == "sigstoreSigned"' \
    /etc/containers/policy.json >/dev/null; then
    echo "${target}: not in /etc/containers/policy.json, leaving ${image} as it is" >&2
    exit 0
fi
if ! skopeo inspect --raw "docker://${target}" >/dev/null 2>&1; then
    echo "${target}: not published yet, staying on ${image}"
    exit 0
fi

if [[ "${dry_run}" == true ]]; then
    echo "${image}: would switch to ${target}"
    exit 0
fi
echo "${image}: switching to ${target}"
bootc switch --enforce-container-sigpolicy "${target}"
