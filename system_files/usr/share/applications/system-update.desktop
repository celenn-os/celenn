[Desktop Entry]
Type=Application
Name=System Update
Name[fr]=Mises à jour
Name[de]=Updates
Name[es]=Actualizaciones
Name[it]=Aggiornamenti
Name[pt_BR]=Atualizações
Comment=Update cosmic-blue, flatpak apps, Homebrew and Distrobox containers
Comment[fr]=Mettre à jour cosmic-blue, les applications Flatpak, Homebrew et les conteneurs Distrobox
Comment[de]=cosmic-blue, Flatpak-Apps, Homebrew und Distrobox-Container aktualisieren
Comment[es]=Actualiza cosmic-blue, las aplicaciones Flatpak, Homebrew y los contenedores de Distrobox
Comment[it]=Aggiorna cosmic-blue, le app Flatpak, Homebrew e i container Distrobox
Comment[pt_BR]=Atualize o cosmic-blue, os aplicativos Flatpak, o Homebrew e os contêineres do Distrobox
Icon=cosmic-blue-update
Categories=ConsoleOnly;System;
Terminal=true
Exec=/usr/bin/ujust update
