# Some time after boot, then every 6 hours: the switch happens soon after the
# new image is published, and applies at the next reboot.
[Unit]
Description=Move to the cosmic-blue image under its new name, Celenn OS
ConditionPathExists=/run/ostree-booted

[Timer]
OnBootSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
