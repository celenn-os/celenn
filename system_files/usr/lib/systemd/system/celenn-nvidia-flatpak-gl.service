# Enabled in cosmic-blue-nvidia only (build_files/35-nvidia.sh)
[Unit]
Description=Install the Flatpak NVIDIA GL extensions matching the driver
Documentation=file:///usr/libexec/celenn-nvidia-flatpak-gl
Wants=network-online.target
After=network-online.target flatpak-system-helper.service
ConditionPathExists=/sys/module/nvidia/version
ConditionPathExists=/run/ostree-booted
# Offline: a few retries, then the next boot (or Flatpak's own update)
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/usr/libexec/celenn-nvidia-flatpak-gl check
ExecStart=/usr/libexec/celenn-nvidia-flatpak-gl sync
Restart=on-failure
RestartSec=2min
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
