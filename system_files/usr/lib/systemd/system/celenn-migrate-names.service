[Unit]
Description=Move the settings of a system installed as cosmic-blue to the names of Celenn OS
Documentation=file:///usr/libexec/celenn-migrate-names
After=local-fs.target systemd-sysusers.service systemd-user-sessions.service
Before=celenn-user-defaults.service celenn-migrate-defaults.service
Before=celenn-parental-controls.service celenn-family-dns.service
Before=cosmic-greeter.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/celenn-migrate-names

[Install]
WantedBy=multi-user.target
