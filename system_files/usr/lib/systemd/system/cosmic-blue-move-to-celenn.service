[Unit]
Description=Move to the cosmic-blue image under its new name, Celenn OS
Documentation=file:///usr/libexec/cosmic-blue-move-to-celenn
Wants=network-online.target
After=network-online.target
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
ExecStart=/usr/libexec/cosmic-blue-move-to-celenn
