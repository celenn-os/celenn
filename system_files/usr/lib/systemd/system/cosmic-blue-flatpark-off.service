[Unit]
Description=Turn off the FlatPark Flatpak remote enabled by older cosmic-blue images
Documentation=file:///usr/libexec/cosmic-blue-flatpark-off
After=local-fs.target
ConditionPathExists=!/var/lib/cosmic-blue/flatpark-off-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/cosmic-blue-flatpark-off

[Install]
WantedBy=multi-user.target
