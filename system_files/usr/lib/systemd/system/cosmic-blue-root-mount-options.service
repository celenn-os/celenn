[Unit]
Description=Apply the root btrfs mount options of /etc/fstab (compression)
Documentation=file:///usr/libexec/cosmic-blue-root-mount-options
After=local-fs.target ostree-remount.service
ConditionPathExists=/run/ostree-booted

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/cosmic-blue-root-mount-options

[Install]
WantedBy=multi-user.target
